# Copy this file to .env and edit DATABASE_URL.
# Example for local MySQL:
DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@127.0.0.1:3306/psd_pvt_ltd

# Ollama must be running and the model must be available to your Ollama account.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:31b-cloud

# Safe demo defaults
MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=15
SCHEMA_REFRESH_SECONDS=300
